# Salin file ini menjadi ".env" lalu sesuaikan nilainya sebelum menjalankan server.

# Port server dijalankan
PORT=3000

# Password untuk masuk ke Admin Dashboard (WAJIB diganti sebelum acara)
ADMIN_PASSWORD=admin123

# Nomor WhatsApp Admin (format internasional tanpa "+" dan tanpa spasi, contoh: 6281234567890)
ADMIN_WA_NUMBER=6281234567890

# Info Rekening Bank untuk pembayaran
BANK_NAME=Bank Central Asia (BCA)
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME=Panitia APTIRMIKI

# URL gambar QRIS (opsional, bisa link gambar yang sudah diupload / data URL)
QRIS_IMAGE_URL=

# Nama acara yang tampil di header
EVENT_NAME=APTIRMIKI
